{
    "name": "turbogrid",
    "version": "3.3.5",
    "description": "A high-performance JavaScript data grid library with zero dependencies",
    "type": "module",
    "main": "dist/turbogrid.js",
    "module": "dist/turbogrid.esm.js",
    "exports": {
        ".": {
            "types": "./dist/turbogrid.d.ts",
            "import": "./dist/turbogrid.esm.js",
            "require": "./dist/turbogrid.js",
            "default": "./dist/turbogrid.esm.js"
        },
        "./package.json": "./package.json"
    },
    "types": "dist/turbogrid.d.ts",
    "scripts": {
        "dev": "vite",
        "lint": "eslint src/ examples/ --fix && stylelint src/**/*.scss",
        "build": "vite build",
        "test": "node scripts/test.js",
        "docs": "vite build --mode docs",
        "docs:preview": "vite preview --mode docs",
        "version": "npm run build",
        "publish": "node ./scripts/publish.js",
        "preview": "vite preview --mode docs"
    },
    "files": [
        "dist",
        "README.zh-Hans.md"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cenfun/turbogrid.git"
    },
    "dependencies": {},
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "async-tick": "^1.0.2",
        "axios": "^1.19.0",
        "chai": "^6.2.2",
        "eight-colors": "^1.3.3",
        "eslint": "^10.8.0",
        "eslint-config-plus": "^2.0.4",
        "eslint-plugin-vue": "^10.10.0",
        "execa": "^10.0.1",
        "mocha": "^11.8.0",
        "monocart-coverage-reports": "^2.12.12",
        "playwright": "^1.62.1",
        "prismjs": "^1.30.0",
        "rollup-plugin-visualizer": "^7.0.1",
        "sass": "^1.102.0",
        "stylelint": "^17.14.1",
        "stylelint-config-plus": "^1.1.6",
        "vine-ui": "^4.0.0",
        "vite": "^8.2.0",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0"
    }
}
